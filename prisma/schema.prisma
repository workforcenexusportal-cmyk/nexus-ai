generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { OWNER ADMIN OPERATOR VIEWER }
enum LeadStatus { NEW QUALIFIED OPPORTUNITY WON LOST }
enum WorkflowStatus { DRAFT ACTIVE PAUSED ARCHIVED }
model Tenant { id String @id @default(cuid()) name String slug String @unique region String @default("eu-central") createdAt DateTime @default(now()) users User[] leads Lead[] workflows Workflow[] agents Agent[] auditEvents AuditEvent[] }
model User { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade) email String name String role Role @default(VIEWER) createdAt DateTime @default(now()) @@unique([tenantId, email]) @@index([tenantId, role]) }
model Lead { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade) name String email String company String? source String score Int @default(0) status LeadStatus @default(NEW) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId, status]) @@index([tenantId, createdAt]) }
model Workflow { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade) name String status WorkflowStatus @default(DRAFT) definition Json version Int @default(1) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId, status]) }
model Agent { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade) name String status String @default("idle") configuration Json version Int @default(1) createdAt DateTime @default(now()) @@index([tenantId, status]) }
model AuditEvent { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade) actorId String action String resource String metadata Json? createdAt DateTime @default(now()) @@index([tenantId, createdAt]) @@index([tenantId, resource]) }
